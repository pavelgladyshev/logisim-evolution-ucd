// Sipeed Tang Nano 20K: the 27 MHz clock, S1, the USB serial port's TX, the TF slot (SPI mode) and LED0-5
IO_LOC "clk" 4;      IO_PORT "clk" IO_TYPE=LVCMOS33;
IO_LOC "s1" 88;      IO_PORT "s1" IO_TYPE=LVCMOS33;
IO_LOC "uart_tx" 69; IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
IO_LOC "sd_sck" 83;  IO_PORT "sd_sck" IO_TYPE=LVCMOS33;
IO_LOC "sd_mosi" 82; IO_PORT "sd_mosi" IO_TYPE=LVCMOS33;
IO_LOC "sd_cs" 81;   IO_PORT "sd_cs" IO_TYPE=LVCMOS33;
IO_LOC "sd_miso" 84; IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led[0]" 15;  IO_PORT "led[0]" IO_TYPE=LVCMOS33;
IO_LOC "led[1]" 16;  IO_PORT "led[1]" IO_TYPE=LVCMOS33;
IO_LOC "led[2]" 17;  IO_PORT "led[2]" IO_TYPE=LVCMOS33;
IO_LOC "led[3]" 18;  IO_PORT "led[3]" IO_TYPE=LVCMOS33;
IO_LOC "led[4]" 19;  IO_PORT "led[4]" IO_TYPE=LVCMOS33;
IO_LOC "led[5]" 20;  IO_PORT "led[5]" IO_TYPE=LVCMOS33;
